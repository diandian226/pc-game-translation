<Project Sdk="Microsoft.NET.Sdk">

  <!--
    目标 .NET Framework 4.8：Win10/11 自带运行库，生成的 exe 双击即用，体积只有几百 KB。
    首次构建会从 NuGet 自动拉取 Microsoft.NETFramework.ReferenceAssemblies（仅编译期使用）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- SDK 项目对 net48 的 WinExe 默认编成 x86；32 位进程启动 explorer.exe 会被重定向到 SysWOW64 而报 0xc0000142 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LocaForge</AssemblyName>
    <RootNamespace>LocaForge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>0.3.3</Version>
    <Product>LocaForge 汉化工坊</Product>
    <Company>LocaForge</Company>
    <Copyright>非官方汉化，仅供学习交流</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <Compile Remove="publish\**" />
    <None Include="catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
